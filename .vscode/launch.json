{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug Example (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/exemple/build/Release/exemple.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/exemple/build",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Compile Example (MSVC)"
        },
        {
            "name": "Debug Example (MinGW)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/exemple/build/exemple.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/exemple/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Compile Example (MinGW)"
        }
    ]
}
