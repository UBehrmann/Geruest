                    "--build",
                    "."
                ]
            }
        },
        {
            "label": "Run Example",
            "type": "shell",
            "command": ".\\Release\\exemple.exe",
            "options": {
                "cwd": "${workspaceFolder}/exemple/build"
            },
            "group": "test",
            "dependsOn": [
                "Compile Example (MSVC)"
            ],
            "isBackground": false,
            "detail": "Run the example server"
        },
        {
            "label": "Run Example (Unix/MinGW)",
            "type": "shell",
            "command": ".\\exemple.exe",
            "options": {
                "cwd": "${workspaceFolder}/exemple/build"
            },
            "group": "test",
            "dependsOn": [
                "Compile Example (Unix/MinGW)"
            ],
            "isBackground": false,
            "detail": "Run the example server (MinGW build on Windows or GCC build on Linux)",
            "windows": {
                "command": ".\\exemple.exe"
            },
            "linux": {
                "command": "./exemple"
            }
        },
        {
            "label": "Build and Run Example (MSVC)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Example Build",
                "Compile Example (MSVC)",
                "Run Example"
            ],
            "group": "test",
            "detail": "Build and run the example server with MSVC"
        },
        {
            "label": "Build and Run Example (Unix/MinGW)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Example Build",
                "Compile Example (Unix/MinGW)",
                "Run Example (Unix/MinGW)"
            ],
            "group": "test",
            "detail": "Build and run the example server with MinGW (Windows) or GCC (Linux)"
        },
        {
            "label": "Clean Example Build",
            "type": "shell",
            "command": "Remove-Item",
            "args": [
                "-Recurse",
                "-Force",
                "build",
                "-ErrorAction",
                "SilentlyContinue"
            ],
            "options": {
                "cwd": "${workspaceFolder}/exemple"
            },
