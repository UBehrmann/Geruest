{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean Build Directory",
            "type": "shell",
            "command": "Remove-Item",
            "args": [
                "-Recurse",
                "-Force",
                "build",
                "-ErrorAction",
                "SilentlyContinue"
            ],
            "group": "build",
            "detail": "Clean the build directory",
            "windows": {
                "command": "Remove-Item",
                "args": [
                    "-Recurse",
                    "-Force",
                    "build",
                    "-ErrorAction",
                    "SilentlyContinue"
                ]
            },
            "linux": {
                "command": "rm",
                "args": [
                    "-rf",
                    "build"
                ]
            }
        },
        {
            "label": "Configure CMake (MSVC)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "..",
                "-A",
                "x64",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "dependsOn": [
                "Create Build Directory"
            ],
            "detail": "Configure CMake with MSVC compiler"
        },
        {
            "label": "Configure CMake (Unix/MinGW)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "..",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "dependsOn": [
                "Create Build Directory"
            ],
            "detail": "Configure CMake with MinGW compiler (Windows) or Unix Makefiles (Linux)",
            "windows": {
                "args": [
                    "..",
                    "-G",
                    "MinGW Makefiles",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            },
            "linux": {
                "args": [
                    "..",
                    "-G",
                    "Unix Makefiles",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            }
        },
        {
            "label": "Create Build Directory",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (!(Test-Path 'build')) { mkdir build }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "detail": "Create build directory if it doesn't exist",
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "if (!(Test-Path 'build')) { mkdir build }"
                ]
            },
            "linux": {
                "command": "mkdir",
                "args": [
                    "-p",
                    "build"
                ]
            }
        },
        {
            "label": "Build Library (MSVC)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Configure CMake (MSVC)"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Build the Geruest library using MSVC"
        },
        {
            "label": "Build Library (Unix/MinGW)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Configure CMake (Unix/MinGW)"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the Geruest library using MinGW (Windows) or GCC (Linux)",
            "linux": {
                "args": [
                    "--build",
                    "."
                ]
            }
        },
        {
            "label": "Install Library (MSVC)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--install",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "dependsOn": [
                "Build Library (MSVC)"
            ],
            "detail": "Install the Geruest library"
        },
        {
            "label": "Install Library (Unix/MinGW)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--install",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "dependsOn": [
                "Build Library (Unix/MinGW)"
            ],
            "detail": "Install the Geruest library",
            "linux": {
                "args": [
                    "--install",
                    "."
                ]
            }
        },
        {
            "label": "Build Example (MSVC)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "..",
                "-A",
                "x64",
                "-DCMAKE_BUILD_TYPE=Release"
