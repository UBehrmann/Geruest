                ]
            }
        },
        {
            "label": "Compile Example (MSVC)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/exemple/build"
            },
            "group": "build",
            "dependsOn": [
                "Build Example (MSVC)"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Compile the example executable"
        },
        {
            "label": "Compile Example (Unix/MinGW)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/exemple/build"
            },
            "group": "build",
            "dependsOn": [
