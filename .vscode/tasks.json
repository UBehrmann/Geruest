            "windows": {
                "args": [
                    "..",
                    "-G",
                    "MinGW Makefiles",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            },
            "linux": {
                "args": [
                    "..",
                    "-G",
                    "Unix Makefiles",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            }
        },
        {
            "label": "Create Example Build Directory",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (!(Test-Path 'build')) { mkdir build }"
            ],
            "options": {
                "cwd": "${workspaceFolder}/exemple"
            },
