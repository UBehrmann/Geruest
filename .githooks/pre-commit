#!/usr/bin/env bash
# Auto-bump the patch version in CMakeLists.txt on the first commit after a push.
# Skipped when the version already differs from the upstream branch
# (already bumped since the last push, or changed by hand).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
exec 9>>"$(git rev-parse --git-dir)/pre-commit.log"
BASH_XTRACEFD=9
echo "=== $(date)" >&9
set -x

file=CMakeLists.txt
re='s/^project\(GeruestLibrary VERSION ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p'

upstream=$(git rev-parse -q --verify '@{u}') || exit 0
old=$(git show "$upstream:$file" 2>/dev/null | sed -nE "$re")
cur=$(git show ":$file" | sed -nE "$re")
[[ -n "$cur" && "$old" == "$cur" ]] || exit 0

IFS=. read -r major minor patch <<< "$cur"
new="$major.$minor.$((patch + 1))"
bump="s/^(project\(GeruestLibrary VERSION )$cur/\1$new/"

# Bump index and working tree separately so unstaged edits to the file stay unstaged.
blob=$(git show ":$file" | sed -E "$bump" | git hash-object -w --stdin)
git update-index --cacheinfo "$(git ls-files -s -- "$file" | cut -d' ' -f1),$blob,$file"
sed -i -E "$bump" "$file"
echo "pre-commit: bumped version $cur -> $new" >&2
