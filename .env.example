# Geruest Server Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Server Configuration
# ============================================

# Port number for the server to listen on
# Default: 8080
PORT=8080

# Hostname for the server
# Default: localhost
HOSTNAME=localhost

# ============================================
# Image Processing
# ============================================

# Enable automatic PNG/JPG to WebP conversion
# Requires libwebp library to be installed
# Values: true, false, 1, 0, yes, no, on, off
# Default: false
WEBP_CONVERSION=false

# WebP encoding quality (0-100)
# Higher values = better quality, larger files
# 0-50: Low quality (thumbnails)
# 50-70: Medium quality (backgrounds)  
# 70-85: High quality (recommended)
# 85-100: Near-lossless (high fidelity)
# Default: 75
WEBP_QUALITY=75

# ============================================
# Asset Management
# ============================================

# Enable automatic CSS/JS asset merging per page
# Reduces HTTP requests by combining assets
# Values: true, false, 1, 0, yes, no, on, off
# Default: false
MERGE_ASSETS=false

# ============================================
# Development Settings
# ============================================

# Enable development mode
# - Verbose logging (debug level)
# - No file caching (changes visible immediately)
# - Preserves HTML/CSS/JS comments
# Values: true, false, 1, 0, yes, no, on, off
# Default: false
DEV_MODE=false

# ============================================
# Threading Configuration
# ============================================

# Number of worker threads for handling connections
# Recommended: CPU cores × 2
# Default: Automatically detected (std::thread::hardware_concurrency() * 2)
# WORKER_THREADS=8

# Maximum number of pending connections in queue
# Higher values = more memory, better handling of traffic spikes
# Lower values = less memory, may reject connections under load
# Default: 500
MAX_QUEUE_SIZE=500

# Maximum number of requests per keep-alive connection
# 0 = unlimited
# Default: 1000
MAX_REQUESTS_PER_CONNECTION=1000

# ============================================
# Logging Configuration
# ============================================

# Log level for filtering output
# Options: none, error, warning, info, debug
# - none: No logging
# - error: Only critical errors (recommended for production)
# - warning: Errors and warnings
# - info: Errors, warnings, and informational messages
# - debug: All messages including verbose debug info (recommended for development)
# Default: error
LOG_LEVEL=error

# ============================================
# Email Configuration (SMTP)
# ============================================

# SMTP server hostname
# Examples: smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net
SMTP_SERVER=smtp.gmail.com

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
# Default: 587
SMTP_PORT=587

# SMTP authentication username
# Usually your email address
SMTP_USERNAME=your-email@gmail.com

# SMTP authentication password
# For Gmail: Use an App Password, not your account password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# Email "From" address
# If not set, uses SMTP_USERNAME as from address
# Default: Same as SMTP_USERNAME
SMTP_FROM_ADDRESS=noreply@example.com

# Enable TLS encryption
# Recommended: true for security
# Default: true
SMTP_USE_TLS=true

# ============================================
# Email Spam Protection
# ============================================

# Minimum seconds between emails from the same IP address
# Prevents rapid-fire email spam
# Default: 60
EMAIL_MIN_INTERVAL=60

# Maximum number of emails per IP in tracking window
# IPs exceeding this limit will be blocked
# Default: 10
EMAIL_MAX_PER_IP=10

# Duration (seconds) to track IP activity
# After this time, IP counters reset
# Default: 3600 (1 hour)
EMAIL_TRACKING_DURATION=3600

# Maximum number of emails in the send queue
# Prevents memory exhaustion from spam attacks
# Default: 1000
EMAIL_MAX_QUEUE_SIZE=1000

# ============================================
# Notes
# ============================================

# 1. Lines starting with # are comments
# 2. Empty lines are ignored
# 3. Format: KEY=value (whitespace around = is ignored)
# 4. Quotes are optional: KEY="value" or KEY=value
# 5. Boolean values are case-insensitive

# Configuration Hierarchy:
# 1. Code (highest priority) - Values set via C++ setters
# 2. .env file - Values from this file
# 3. Environment variables (lowest priority) - System env vars

# For production deployments, consider using environment
# variables instead of .env files for better security.
